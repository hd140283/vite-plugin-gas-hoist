{
	"name": "vite-plugin-gas-hoist",
	"version": "0.2.0",
	"description": "A Vite plugin that hoists entry point exports to the global scope for Google Apps Script",
	"keywords": [
		"vite-plugin",
		"vite",
		"google-apps-script",
		"gas",
		"clasp"
	],
	"license": "MIT",
	"author": "Taiki Watanabe",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/hd140283/vite-plugin-gas-hoist.git"
	},
	"type": "module",
	"main": "./src/index.js",
	"exports": {
		".": "./src/index.js"
	},
	"files": [
		"src"
	],
	"engines": {
		"node": ">=22"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "^22 || ^24 || >=26",
			"onFail": "error"
		},
		"packageManager": {
			"name": "pnpm",
			"version": "12",
			"onFail": "error"
		}
	},
	"scripts": {
		"test": "vitest run",
		"lint": "biome check --write",
		"example:dev": "cd example && npm run dev",
		"example:build": "cd example && npm run build",
		"example:login": "pnpx @google/clasp@2.5 login",
		"example:push": "cd example && pnpx @google/clasp@2.5 push"
	},
	"compatiblePackages": {
		"schemaVersion": 1,
		"rollup": {
			"type": "incompatible",
			"reason": "Requires Vite's configResolved hook to read build.lib.name"
		},
		"rolldown": {
			"type": "incompatible",
			"reason": "Requires Vite's configResolved hook to read build.lib.name"
		}
	},
	"peerDependencies": {
		"vite": "^6.0.0 || ^7.0.0 || ^8.0.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.8",
		"acorn": "^8.16.0",
		"vite": "^8.0.3",
		"vitest": "^5.1.1"
	}
}
